# Copy this file to ".env" and adjust the values. Never commit ".env".
#
# docker-compose reads this file for the POSTGRES_* variables.
# The backend reads it when run locally (outside Docker) from the repo root ".env".

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=edital
POSTGRES_PASSWORD=edital
POSTGRES_DB=edital_claro

# --- Backend ---
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Used when the backend runs outside Docker. Inside docker-compose this is
# overridden to point at the "db" service.
DATABASE_URL=postgresql+psycopg://edital:edital@localhost:5432/edital_claro

# Folder for uploaded PDFs when the backend runs outside Docker.
# Default: data/uploads in the repository (ignored by git).
# STORAGE_DIR=data/uploads
# Maximum upload size, in megabytes.
MAX_UPLOAD_MB=50
# Tesseract language pack for the OCR fallback (scanned pages only).
OCR_LANGUAGE=por
OCR_TIMEOUT_SECONDS=600
# Maximum chunk size, in characters.
CHUNK_MAX_CHARS=2000

# --- LLM (extraction) ---
# Anthropic API key. Required to analyze editais; never commit the real value.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# How many extraction calls of one analysis may run at the same time.
LLM_MAX_CONCURRENCY=3
# Local embedding model (downloaded from Hugging Face on first use, about 1 GB).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Prompt set used for extraction (a folder under backend/prompts/).
EXTRACTION_PROMPT_VERSION=extraction/v1

# --- Frontend ---
# Backend URL as seen by the Next.js server. Inside docker-compose this is
# overridden to http://backend:8000. For local "npm run dev", the default
# (http://localhost:8000) applies; to change it, set API_URL in frontend/.env.local.
API_URL=http://localhost:8000
