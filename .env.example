# Copy this file to ".env" and adjust the values. Never commit ".env".
#
# docker-compose reads this file for the POSTGRES_* variables.
# The backend reads it when run locally (outside Docker) from the repo root ".env".

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=edital
POSTGRES_PASSWORD=edital
POSTGRES_DB=edital_claro

# --- Backend ---
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Used when the backend runs outside Docker. Inside docker-compose this is
# overridden to point at the "db" service.
DATABASE_URL=postgresql+psycopg://edital:edital@localhost:5432/edital_claro

# --- Frontend ---
# Backend URL as seen by the Next.js server. Inside docker-compose this is
# overridden to http://backend:8000. For local "npm run dev", the default
# (http://localhost:8000) applies; to change it, set API_URL in frontend/.env.local.
API_URL=http://localhost:8000
