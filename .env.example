# Copy this file to ".env" and adjust the values. Never commit ".env".
#
# docker-compose reads this file for the POSTGRES_* variables.
# The backend reads it when run locally (outside Docker) from the repo root ".env".

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=edital
POSTGRES_PASSWORD=edital
POSTGRES_DB=edital_claro

# --- Backend ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Used when the backend runs outside Docker. Inside docker-compose this is
# overridden to point at the "db" service.
DATABASE_URL=postgresql+psycopg://edital:edital@localhost:5432/edital_claro

# Folder for uploaded PDFs when the backend runs outside Docker.
# Default: data/uploads in the repository (ignored by git).
# STORAGE_DIR=data/uploads
# Maximum upload size, in megabytes.
MAX_UPLOAD_MB=50
# Tesseract language pack for the OCR fallback (scanned pages only).
OCR_LANGUAGE=por
OCR_TIMEOUT_SECONDS=600
# Maximum chunk size, in characters.
CHUNK_MAX_CHARS=2000

# --- LLM (extraction, risks, attestations) ---
# anthropic | openai. Only the chosen provider's key is needed; never commit real values.
LLM_PROVIDER=anthropic
# Anthropic key (console.anthropic.com; starts with sk-ant-).
ANTHROPIC_API_KEY=
# OpenAI key (platform.openai.com).
OPENAI_API_KEY=
# Model of the chosen provider; empty uses the default (claude-opus-5-5 or gpt-6.1-sol).
# Prices of known models are in backend/app/llm/pricing.py; a model without a price is
# refused while a spending limit is active.
LLM_MODEL=
# How many extraction calls of one analysis may run at the same time.
LLM_MAX_CONCURRENCY=3
# Local embedding model (downloaded from Hugging Face on first use, about 1 GB).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Prompt set used for extraction (a folder under backend/prompts/).
EXTRACTION_PROMPT_VERSION=extraction/v1
# Prompt set of the risk analysis and of the attestation comparison (eligibility).
RISK_PROMPT_VERSION=risks/v1
ELIGIBILITY_PROMPT_VERSION=eligibility/v1

# --- Limits and security ---
# Spending limit per analysis (extraction + risks) and per eligibility check, in
# estimated USD (prices in backend/app/llm/pricing.py). 0 disables the limit.
ANALYSIS_MAX_COST_USD=3.0
ELIGIBILITY_MAX_COST_USD=0.5
# Largest PDF accepted, in pages.
MAX_PDF_PAGES=300
# Requests per client IP: all endpoints per minute, and costly ones (uploads,
# imports, PNCP searches, analyses, eligibility) per hour. 0 disables a limit.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_COSTLY_PER_HOUR=30
# Proxies (addresses or CIDR networks) whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# --- Public demo and deploy (docs/DEPLOY.md) ---
# Demo mode: serves the analyses of data/demo and refuses uploads, imports and new
# analyses. Off for normal use.
DEMO_MODE=false
# Seconds to wait for the database connection (raise it for databases that sleep).
DATABASE_CONNECT_TIMEOUT_SECONDS=2
# Shared secret between the frontend server and the backend, when the frontend has
# no fixed address (Vercel). Set the same value on both sides; leave empty locally.
PROXY_TOKEN=

# --- PNCP (public APIs, no key needed) ---
PNCP_CONSULTA_URL=https://pncp.gov.br/api/consulta
PNCP_API_URL=https://pncp.gov.br/api/pncp
PNCP_TIMEOUT_SECONDS=30
PNCP_MAX_RETRIES=3
# Minimum pause between two requests to the PNCP, in seconds.
PNCP_MIN_INTERVAL_SECONDS=1.0
# Cached PNCP responses (default: data/cache/pncp in the repository) and how long they last.
# PNCP_CACHE_DIR=data/cache/pncp
PNCP_CACHE_TTL_SECONDS=3600
# Result pages (50 each) read per modality in one search.
PNCP_SEARCH_MAX_PAGES=10

# --- Frontend ---
# Backend URL as seen by the Next.js server. Inside docker-compose this is
# overridden to http://backend:8000. For local "npm run dev", the default
# (http://localhost:8000) applies; to change it, set API_URL in frontend/.env.local.
API_URL=http://localhost:8000
# With PROXY_TOKEN: the request header in which the hosting platform puts the
# visitor's address and that visitors cannot set (Vercel: x-real-ip). Leave empty
# when the frontend is reached directly (docker-compose, npm run dev).
CLIENT_IP_HEADER=
